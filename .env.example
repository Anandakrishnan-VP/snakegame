# BIS Saathi Environment Variables
# Provide your Groq API key for LLM synthesis.
# If omitted or left blank, BIS Saathi runs in 100% offline deterministic mode.
GROQ_API_KEY=

# Configurable Groq Models (defaults: primary=openai/gpt-oss-120b, fast=openai/gpt-oss-20b)
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# CORS allowed origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
