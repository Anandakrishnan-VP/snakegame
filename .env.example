# BIS Saathi Environment Variables
# Provide your Groq API key for LLM synthesis.
# If omitted or left blank, BIS Saathi runs in 100% offline deterministic mode.
GROQ_API_KEY=

# Configurable Groq Models (defaults: primary=openai/gpt-oss-120b, fast=openai/gpt-oss-20b)
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# CORS allowed origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Supabase (PostgreSQL) Cloud Database (Optional)
# If provided, connects to Supabase for multi-device cross-session persistence.
# If omitted or left blank, gracefully falls back to local SQLite.
# Format (from Supabase Project Settings -> Database -> Connection string -> URI, use pooled port 6543):
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Tier-2 Live Web Intelligence Fallback (Optional)
# Strictly Second Option: Triggered ONLY when local SQLite directory has 0 matches.
# Searches official bis.gov.in & standards.bis.gov.in via Tavily (Free 1,000 credits/mo, no card required).
# Get your free key at: https://app.tavily.com
TAVILY_API_KEY=